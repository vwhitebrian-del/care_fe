# انسخ إلى .env وغيّر كل القيم التي تحمل CHANGE_ME
POSTGRES_USER=care
POSTGRES_PASSWORD=CHANGE_ME_DB
POSTGRES_DB=care
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://care:CHANGE_ME_DB@db:5432/care
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

DJANGO_SETTINGS_MODULE=config.settings.deployment
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM
DJANGO_ADMIN_URL=admin
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=False
# عنوان السيرفر داخل شبكة المستشفى (مثل 192.168.1.10)
DJANGO_ALLOWED_HOSTS=*

BUCKET_REGION=ap-south-1
BUCKET_KEY=CHANGE_ME_MINIO_USER
BUCKET_SECRET=CHANGE_ME_MINIO_PASS
BUCKET_ENDPOINT=http://minio:9000
# يجب أن يصله المتصفح: http://<عنوان السيرفر>:9100
BUCKET_EXTERNAL_ENDPOINT=http://192.168.1.10:9100
FILE_UPLOAD_BUCKET=patient-bucket
FACILITY_S3_BUCKET=facility-bucket

SNS_ACCESS_KEY=0
SNS_SECRET_KEY=0
EMAIL_HOST=localhost
EMAIL_USER=0
EMAIL_PASSWORD=0

WEB_PORT=80
BACKUP_KEEP_DAYS=14
